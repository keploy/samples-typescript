# Keploy UI capture. Copy this file to .env and put your app's UI ingest key in it.
# A UI ingest key can only post recordings into the one app it was made for, so it
# is safe in a page every visitor can read. Never put any other Keploy key here.
NEXT_PUBLIC_KEPLOY_INGEST_ENDPOINT=https://api.keploy.io/ui/v1/ingest
NEXT_PUBLIC_KEPLOY_INGEST_KEY=kep_YOUR_INGEST_KEY
