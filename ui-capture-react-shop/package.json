{
  "name": "ui-capture-react-shop",
  "version": "1.0.0",
  "private": true,
  "description": "A small React shop recorded with Keploy UI capture (@keploy/capture-sdk)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "demo:visits": "node --env-file-if-exists=.env scripts/demo-visits.mjs",
    "test": "playwright test",
    "test:serve": "vite build --outDir dist-test --emptyOutDir && vite preview --outDir dist-test --host 127.0.0.1 --port 4174 --strictPort"
  },
  "dependencies": {
    "@keploy/capture-sdk": "3.1.0-rc.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
