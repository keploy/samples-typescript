{
  "name": "ui-capture-html-shop",
  "version": "1.0.0",
  "private": true,
  "description": "A small plain-HTML shop, no bundler, recorded with Keploy UI capture (@keploy/capture-sdk)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
