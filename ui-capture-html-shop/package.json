    "demo:visits": "node --env-file-if-exists=.env scripts/demo-visits.mjs",
    "test": "playwright test",
    "test:serve": "node server.mjs"
  },
  "dependencies": {
    "@keploy/capture-sdk": "3.1.0",
    "rrweb": "2.2.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
